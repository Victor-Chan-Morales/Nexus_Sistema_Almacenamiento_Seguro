# Copiar a ".env" (nunca commitear ".env" — ver .gitignore) y ajustar valores.
# Estas son las 4 variables que Docker Compose pasa al contenedor oficial de PostgreSQL.
# NOTA: no se arma aquí una DATABASE_URL combinando estas variables — la interpolación de
# "${VAR}" dentro de un mismo archivo .env no es consistente entre versiones de Docker Compose.
# DATABASE_URL se arma en docker-compose.yml (ahí sí es fiable), a partir de estas 4 variables.

POSTGRES_DB=paas_platform
POSTGRES_USER=paas_app
# Generar uno propio, no usar este valor en ningún entorno real:
#   openssl rand -base64 24
POSTGRES_PASSWORD=change_me_dev_only
# Puerto expuesto en el HOST para conectarte con psql/DBeaver/etc. desde fuera de Docker.
# El contenedor de PostgreSQL siempre escucha en 5432 puertas adentro de la red de Docker,
# sin importar el valor de esta variable.
POSTGRES_PORT=5432

# URL interna del database-service (el único que habla con PostgreSQL). El resto de los
# microservicios (iam, files, billing, admin) usan ESTA variable, nunca credenciales de
# PostgreSQL directamente — ver database/README.md, sección "Servicio de Base de Datos unificado".
# audit además necesita, aparte de esto, la URL de Redis Streams (fuera del alcance de este .env).
DATABASE_SERVICE_URL=http://database-service:3000
