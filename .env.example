# =============================================================================
# Nexus — Variables de entorno locales
# Solo para desarrollo local. NUNCA reutilizar en producción.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=nexus_dev
POSTGRES_USER=nexus_dev
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=nexus_local
MINIO_ROOT_PASSWORD=local_only_change_me_please
MINIO_BUCKET=nexus-dev
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false

# ── API (Monolito NestJS) ─────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────────────────────────
# Cambia este valor por una cadena segura antes de cualquier despliegue
JWT_SECRET=dev-secret-cambia-esto-antes-de-produccion
JWT_EXPIRES_IN=7d

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# URL base del API consumida por el frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
WEB_URL=http://localhost:3000
