# =============================================================================
# Nexus — Variables de entorno locales
# Solo para desarrollo local. NUNCA reutilizar en producción.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=nexus_dev
POSTGRES_USER=nexus_dev
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# ── SeaweedFS S3 ─────────────────────────────────────────────────────────────────────
S3_ACCESS_KEY=nexus_local
S3_SECRET_KEY=local_only_change_me_please
S3_FILER_SIGNING_KEY=local_dev_filer_signing_key_change_before_deploy
S3_BUCKET=nexus-dev
S3_ENDPOINT=localhost
S3_PORT=8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_USE_SSL=false

# ── API (Monolito NestJS) ─────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────────────────────────
# Cambia este valor por una cadena segura antes de cualquier despliegue
JWT_SECRET=dev-secret-cambia-esto-antes-de-produccion
JWT_EXPIRES_IN=7d

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# URL base del API consumida por el frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ── API/IAM ────────────────────────────────────────────────────────
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789   # >= 32 caracteres; en producción no puede empezar con "dev-only"
IAM_REQUIRE_VERIFIED_EMAIL=true     # propuesta de contrato: el login exige correo verificado
COOKIE_SECURE=false                 # true en producción (HTTPS)
COOKIE_SAMESITE=lax                 # lax | strict | none (none exige COOKIE_SECURE=true)
APP_URL=http://localhost:3000       # base del enlace de verificación (frontend)
WEB_ORIGIN=http://localhost:3000    # origen permitido por CORS con credenciales

# SMTP de desarrollo (ADR-003): Mailpit, UI en http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Nexus <no-reply@nexus.local>"
# Mailtrap: MAIL_HOST=sandbox.smtp.mailtrap.io  MAIL_PORT=2525  MAIL_USER=...  MAIL_PASS=...
