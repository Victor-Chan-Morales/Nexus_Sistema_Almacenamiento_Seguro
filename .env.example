# =============================================================================
# Nexus — Variables de entorno locales
# Solo para desarrollo local. NUNCA reutilizar en producción.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=nexus_dev
POSTGRES_USER=nexus_dev
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# ── SeaweedFS S3 ─────────────────────────────────────────────────────────────────────
S3_ACCESS_KEY=nexus_local
S3_SECRET_KEY=local_only_change_me_please
S3_FILER_SIGNING_KEY=local_dev_filer_signing_key_change_before_deploy
S3_BUCKET=nexus-dev
S3_ENDPOINT=localhost
S3_PORT=8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_USE_SSL=false

# ── API (Monolito NestJS) ─────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────────────────────────
# Cambia este valor por una cadena segura antes de cualquier despliegue
JWT_SECRET=dev-secret-cambia-esto-antes-de-produccion
JWT_EXPIRES_IN=7d

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# URL base del API consumida por el frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
WEB_URL=http://localhost:3000
