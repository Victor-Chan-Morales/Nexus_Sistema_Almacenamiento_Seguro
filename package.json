{
  "name": "nexus-almacenamiento-seguro",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace @nexus/web",
    "build:web": "npm run build --workspace @nexus/web",
    "lint:web": "npm run lint --workspace @nexus/web",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@nestjs/platform-express": "^12.1.1",
    "multer": "^2.4.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1"
  }
}
