{
  "name": "nexus-almacenamiento-seguro",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @nexus/web",
    "build:web": "npm run build --workspace @nexus/web",
    "lint:web": "npm run lint --workspace @nexus/web",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3"
  }
}
