# Dirección de acceso desde el navegador y puertos publicados en el servidor.
NEXUS_PUBLIC_HOST=localhost
NEXUS_BIND_ADDRESS=127.0.0.1
NEXUS_WEB_PORT=3000
NEXUS_API_PORT=3001
COMPOSE_PROJECT_NAME=nexus-on-premises

# install.sh genera estos valores durante la primera instalación.
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FILER_SIGNING_KEY=
JWT_SECRET=
FILES_MASTER_KEY=
FILES_MASTER_KEY_V2=
FILES_MASTER_KEY_CURRENT_VERSION=1

# Activa la verificación cuando el servidor SMTP esté configurado.
IAM_REQUIRE_VERIFIED_EMAIL=false
NEXUS_API_NODE_ENV=development
MAIL_TRANSPORT=smtp
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_REQUIRE_TLS=
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Nexus <no-reply@nexus.local>"
